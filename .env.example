# ==============================================================================
# HSECORE Enterprise Platform - Environment Configuration Template
# Managed automatically by install.sh or copy to .env and configure values.
# ==============================================================================

# Application Runtime & Access Configuration
NODE_ENV=production
APP_VERSION=0.2.8
PORT=
APP_PORT=
APP_INTERNAL_PORT=
PUBLIC_PORT=
DOCKER_BIND_IP=
HOST_TYPE=
DOMAIN=
APP_URL=
SSL_ENABLED=false
TRUST_PROXY=1

# PostgreSQL Database Configuration
SQL_HOST=
SQL_PORT=
POSTGRES_PORT=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_SSL=false
SQL_SSL_CA=
PG_MAX_POOL=15
STRICT_DB_STARTUP=true

# Security & Authentication
JWT_SECRET=
JWT_EXPIRY=8h
# Comma-separated exact origins (no wildcards). Same-origin always allowed.
CORS_ORIGINS=
# Set true only for Google AI Studio / Cloud Run preview deployments
ALLOW_PREVIEW_ORIGINS=false
# Application Content-Security-Policy (true/false)
CSP_ENABLED=true

# Persistent Storage
UPLOAD_DIR=/app/uploads

# Optional External Integrations (Server-Side Only)
FORECA_API_KEY=
ACCUWEATHER_API_KEY=
IRIMO_API_KEY=

# ==============================================================================
# HSECORE Local AI Engine (Ollama / Local LLM) Configuration
# Fully offline, internal Docker network only, strictly zero external dependencies
# ==============================================================================
AI_ENGINE_ENABLED=false
AI_ENGINE_URL=http://hse-ai-engine:11434
AI_DEFAULT_CHAT_MODEL=
AI_DEFAULT_EMBED_MODEL=
OLLAMA_IMAGE=ollama/ollama:0.40.13
AI_CPU_LIMIT=4.0
AI_MEMORY_LIMIT=8192M
AI_MEMORY_LIMIT_AUTO=true
AI_CPU_THREADS=4
AI_CLOUD_FALLBACK_ENABLED=false
AI_CONTEXT_TOKENS=2048
AI_CONTEXT_TOKENS_AUTO=true
AI_MAX_CONCURRENCY=1
AI_MAX_QUEUE_LENGTH=10
AI_MODEL_PULL_TIMEOUT_MS=1800000
AI_NUM_PARALLEL=1
AI_MAX_LOADED_MODELS=1
AI_KEEP_ALIVE=5m
AI_REQUEST_TIMEOUT_MS=180000
AI_HOST_PORT=11434
AI_BIND_IP=127.0.0.1

