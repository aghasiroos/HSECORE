# ==============================================================================
# HSECORE Enterprise Platform - Environment Configuration Template
# Managed automatically by install.sh or copy to .env and configure values.
# ==============================================================================

# Application Runtime & Access Configuration
NODE_ENV=production
APP_VERSION=0.2.8
PORT=
APP_PORT=
APP_INTERNAL_PORT=
PUBLIC_PORT=
DOCKER_BIND_IP=
HOST_TYPE=
DOMAIN=
APP_URL=
SSL_ENABLED=false
TRUST_PROXY=1

# PostgreSQL Database Configuration
SQL_HOST=
SQL_PORT=
POSTGRES_PORT=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_SSL=false
SQL_SSL_CA=
PG_MAX_POOL=15
STRICT_DB_STARTUP=true

# Security & Authentication
JWT_SECRET=
JWT_EXPIRY=7d

# Persistent Storage
UPLOAD_DIR=/app/uploads

# Optional External Integrations (Server-Side Only)
GEMINI_API_KEY=
FORECA_API_KEY=
ACCUWEATHER_API_KEY=
IRIMO_API_KEY=

# ==============================================================================
# HSECORE Local AI Engine (Ollama / Local LLM) Configuration
# Local inference on the VPS; outbound access is used only to pull/update the runtime image and models
# ==============================================================================
AI_ENGINE_ENABLED=true
DOCKER_NETWORK_NAME=hse-network
AI_OLLAMA_VERSION=0.34.0
AI_ENGINE_URL=http://hse-ai-engine:11434
AI_DEFAULT_CHAT_MODEL=qwen3:1.7b
AI_DEFAULT_EMBED_MODEL=bge-m3
AI_CPU_LIMIT=4.0
AI_MEMORY_LIMIT=4096M
AI_CPU_THREADS=4
AI_NUM_PARALLEL=1
AI_MAX_LOADED_MODELS=1
AI_MAX_QUEUE=25
AI_KEEP_ALIVE=15m
AI_REQUEST_TIMEOUT_MS=60000

