# ==============================================================================
# HSECORE Enterprise Platform - Environment Configuration Template
# Managed automatically by install.sh or copy to .env and configure values.
# ==============================================================================

# Application Runtime & Access Configuration
NODE_ENV=production
PORT=
APP_PORT=
APP_INTERNAL_PORT=
PUBLIC_PORT=
DOCKER_BIND_IP=
HOST_TYPE=
DOMAIN=
APP_URL=
SSL_ENABLED=false
TRUST_PROXY=1

# PostgreSQL Database Configuration
SQL_HOST=
SQL_PORT=
POSTGRES_PORT=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_SSL=false
SQL_SSL_CA=
PG_MAX_POOL=15
STRICT_DB_STARTUP=true

# Security & Authentication
JWT_SECRET=
JWT_EXPIRY=7d

# Persistent Storage
UPLOAD_DIR=/app/uploads

# Optional External Integrations (Server-Side Only)
GEMINI_API_KEY=
FORECA_API_KEY=
ACCUWEATHER_API_KEY=
IRIMO_API_KEY=

