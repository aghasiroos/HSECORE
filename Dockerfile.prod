# Production Multi-Stage Dockerfile for Server Deployment (Linux/Musl Alpine Environment)
ARG NODE_BASE_IMAGE=node:22-alpine
FROM ${NODE_BASE_IMAGE} AS builder

WORKDIR /app

# Force IPv4-first DNS resolution and cap V8 heap at 2048MB to prevent Linux swap thrashing on 2GB/4GB VPS
ENV NODE_OPTIONS="--dns-result-order=ipv4first --max-old-space-size=2048" \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_PROGRESS=false \
    NPM_CONFIG_MAXSOCKETS=8 \
    NPM_CONFIG_FETCH_RETRIES=2 \
    NPM_CONFIG_FETCH_TIMEOUT=20000 \
    NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=2000 \
    NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=10000

# 1. Copy package manifests first to leverage Docker layer caching
COPY package.json package-lock.json .npmrc* ./

# 2. Probe the registry and install strictly from the committed lockfile.
# A mirror retry is allowed, but npm install is intentionally forbidden here.
RUN echo ">>> [Builder 1/3] Probing npm registry connectivity..." && \
    if ! wget -q -T 3 -O /dev/null https://registry.npmjs.org/react/-/react-19.0.1.tgz 2>/dev/null; then \
      echo ">>> [Builder 1/3] Switching to https://registry.npmmirror.com ..." && \
      sed -i 's|https://registry.npmjs.org/|https://registry.npmmirror.com/|g' package-lock.json && \
      npm config set registry https://registry.npmmirror.com; \
    else \
      echo ">>> [Builder 1/3] registry.npmjs.org is fast and reachable."; \
    fi && \
    echo ">>> [Builder 2/3] Installing locked npm dependencies..." && \
    (npm ci --no-audit --no-fund --no-progress --prefer-offline --loglevel=http || \
     (echo ">>> [Builder 2/3] Retrying npm ci with registry.npmmirror.com mirror..." && \
      sed -i 's|https://registry.npmjs.org/|https://registry.npmmirror.com/|g' package-lock.json && \
      npm config set registry https://registry.npmmirror.com && \
      npm ci --no-audit --no-fund --no-progress --prefer-offline --loglevel=http))

# 3. Copy project source files (.dockerignore excludes host node_modules and dist)
COPY . .

# 4. Compile production bundle and prune devDependencies locally without re-downloading
RUN echo ">>> [Builder 3/3] Compiling frontend (Vite) and backend (esbuild) bundles..." && \
    npm run build && \
    echo ">>> [Builder 3/3] Pruning devDependencies..." && \
    npm prune --omit=dev --no-audit --no-fund --no-progress --loglevel=error && \
    echo ">>> [Builder 3/3] Build stage completed successfully."

# Final Lightweight Runner Stage
FROM ${NODE_BASE_IMAGE} AS runner

WORKDIR /app

ENV NODE_ENV=production \
    NPM_CONFIG_LOGLEVEL=error \
    NPM_CONFIG_UPDATE_NOTIFIER=false

# Install poppler-utils, poppler-data, ghostscript and font support for perfect Persian PDF rendering
RUN apk add --no-cache \
    poppler-utils \
    poppler-data \
    ghostscript \
    fontconfig \
    ttf-dejavu \
    ttf-freefont \
    font-noto-arabic && \
    fc-cache -f

ARG APP_VERSION=0.2.8
ARG BUILD_ID=unknown
ARG RELEASE_ID=unknown
ARG GIT_COMMIT=unknown
ENV APP_VERSION=$APP_VERSION
ENV BUILD_ID=$BUILD_ID
ENV RELEASE_ID=$RELEASE_ID
ENV GIT_COMMIT=$GIT_COMMIT
LABEL org.opencontainers.image.title="HSECORE Enterprise" \
      org.opencontainers.image.source="https://github.com/aghasiroos/HSECORE" \
      org.opencontainers.image.version="$APP_VERSION" \
      org.opencontainers.image.revision="$GIT_COMMIT"

# Copy manifests, pruned production node_modules, compiled bundle, and migrations from builder
COPY package.json package-lock.json .npmrc* ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/drizzle ./drizzle
COPY create-user-cli.js ./

# Run as non-root (Alpine node image provides uid 1000 "node")
RUN mkdir -p /app/uploads /app/backups /app/data && chown -R node:node /app
USER node

EXPOSE 3000

CMD ["node", "dist/server.cjs"]
